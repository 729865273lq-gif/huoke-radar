# 复制本文件为 .env 并填入你的真实值
# DeepSeek 开放平台 API Key：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 一般不用改
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 轮询间隔（分钟）
POLL_INTERVAL_MINUTES=10
# 每日最大发送私信条数（防封号）
DAILY_SEND_LIMIT=30

# 双层扫描
QUICK_INTERVAL_MINUTES=5
DEEP_INTERVAL_MINUTES=30
QUICK_VIDEOS=5
DEEP_VIDEOS=10
COMMENT_SCROLLS_QUICK=2
COMMENT_SCROLLS_DEEP=4
